/*
 * Paint (C port) - the Windows resources: the manifest, version information
 * and the icon (paint.ico, which the Makefile draws from the logo into the build folder)
 *
 * The window's icon is drawn at run time and set with WM_SETICON; the .ico
 * is only for Explorer and the taskbar before the program starts.
 */
#include <winver.h>

/* The icon: resource 1, which host/win32_win.c loads for the window class.
 * The Makefile makes paint.ico from the logo (tools/mkico.c). */
1 ICON "paint.ico"

/* CREATEPROCESS_MANIFEST_RESOURCE_ID (1), RT_MANIFEST (24) */
1 24 "paint.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0, 3, 3, 0
PRODUCTVERSION 0, 3, 3, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Paint"
            VALUE "FileDescription", "Paint"
            VALUE "FileVersion", "0.3.3"
            VALUE "InternalName", "paint"
            VALUE "LegalCopyright", "MIT licence"
            VALUE "OriginalFilename", "paint.exe"
            VALUE "ProductName", "Paint"
            VALUE "ProductVersion", "0.3.3"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
